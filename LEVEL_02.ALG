Algoritmo "level_02"
// 
//  
// Descrição   : Aqui você descreve o que o programa faz! (função)
// Autor(a)    : Nome do(a) aluno(a)
// Data atual  : 12/06/2026
Var
// Seção de Declarações das variáveis 
cont, peca : inteiro

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
cont <- 1
repita
escreval("=========Contador==========")
escreval("Aperte Enter para Confirmar entrada de Usuario")
leia (peca)
escreval(cont, " Unidade")
cont <- cont + 1
ate cont > 50
escreval("")
escreval("Completo!")


Fimalgoritmo