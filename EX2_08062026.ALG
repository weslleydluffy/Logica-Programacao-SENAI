Algoritmo "EX2_08062026"
// 
//  
// Descrição   : Aqui você descreve o que o programa faz! (função)
// Autor(a)    : Nome do(a) aluno(a)
// Data atual  : 06/06/2026
Var
// Seção de Declarações das variáveis
valor1, valor2 : inteiro

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
escreval("Insira o Primeiro Valor")
leia(valor1)
escreval("Insira o Segundo Valor")
leia(valor2)
 se valor1<valor2 entao
 escreval(valor1, " E o Menor Valor")
 senao
 se valor1>valor2 entao
 escreval(valor2, " E o Menor Valor")
 senao
 escreval("Os Dois Valores sao Iguais")
 fimse
 fimse

Fimalgoritmo