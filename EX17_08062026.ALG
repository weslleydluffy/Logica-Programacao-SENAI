Algoritmo "ex17_08062026"
//
//
// Descrição   : Aqui você descreve o que o programa faz! (função)
// Autor(a)    : Nome do(a) aluno(a)
// Data atual  : 07/06/2026
Var
   // Seção de Declarações das variáveis
opcao : inteiro

Inicio
   // Seção de Comandos, procedimento, funções, operadores, etc...
   escreval("=========Sistema de Pedagio========= ")
   escreval(" ")
   escreval("1-Moto:R$5,00 ")
   escreval("2-Carro:R$10,00 ")
   escreval("3-Caminhao:R$25,00 ")
   escreval("4-Onibus:R$20,00 ")
   escreval(" ")
   escreval("INSIRA O NUMERO DAS OPCOES ACIMA!: ")
   leia(opcao)
   escolha opcao
   caso 1
   escreval(" ")
      escreval("Tipo de Veiculo:")
      escreval("Moto: R$5,00 ")
   caso 2
    escreval(" ")
      escreval("Tipo de Veiculo:")
      escreval("Carro: R$10,00 ")
   caso 3
    escreval(" ")
      escreval("Tipo de Veiculo:")
      escreval("Caminhao: R$25,00 ")
   caso 4
    escreval(" ")
      escreval("Tipo de Veiculo:")
      escreval("Onibus: R$20,00 ")
   outrocaso
    escreval(" ")
      escreval("Tipo de Veiculo Invalido!")
   fimescolha















Fimalgoritmo