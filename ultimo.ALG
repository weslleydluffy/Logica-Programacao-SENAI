Algoritmo "ultimo"
// 
//  
// Descrição   : Aqui você descreve o que o programa faz! (função)
// Autor(a)    : Nome do(a) aluno(a)
// Data atual  : 12/06/2026
Var
// Seção de Declarações das variáveis 
cont, litros,  capacidade : inteiro

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
cont <- 1
litros <- 100
capacidade <- 500
repita
escreval("")
escreval("Ciclo: ", cont)
escreval("")
litros <- litros+15
Escreval("Litros Atual: ", litros)
cont <- cont + 1
ate litros >= capacidade
escreval("Atigiu a Capacidade de : ", capacidade)
Fimalgoritmo