Algoritmo "ex5_08062026"
// 
//  
// Descrição   : Aqui você descreve o que o programa faz! (função)
// Autor(a)    : Nome do(a) aluno(a)
// Data atual  : 06/06/2026
Var
// Seção de Declarações das variáveis 
quantidade_estoque : Inteiro

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
escreval("Insira a Quantidade Em Estoque:")
leia(quantidade_estoque)
se (quantidade_estoque%5=0) entao
escreval("O Numero e Multiplo de 5")
senao
escreval("O Numero nao e Multiplo de 5")
fimse

Fimalgoritmo