Algoritmo "ex12_08062026"
// 
//  
// Descrição   : Aqui você descreve o que o programa faz! (função)
// Autor(a)    : Nome do(a) aluno(a)
// Data atual  : 06/06/2026
Var
// Seção de Declarações das variáveis 
 opcao : inteiro

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
 escreval("========CARDAPIO========== ")
   escreval(" ")
   escreval("1 - Cachorro-Quente")
   escreval("2 - Hamburguer")
   escreval("3 - Pastel")
   escreval("4 - Refrigerante")
   escreval("5 - Suco ")
   escreval("Insira Numero das Opcoes do Cardapio Acima! ")
   leia(opcao)
   escolha opcao
   caso 1
      escreval("Cachorro-Quente ")
   caso 2
      escreval("Hamburguer ")
   caso 3
      escreval("Pastel ")
   caso 4
      escreval("Refrigerante ")
   caso 5
      escreval("Suco ")
   outrocaso
      escreval("Opcao invalida ")
   fimescolha

Fimalgoritmo